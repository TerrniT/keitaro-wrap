# ---------------------------------------------------------------------------
# Keitaro connection
# ---------------------------------------------------------------------------
KEITARO_BASE_URL=https://your-tracker.example.com
# Admin API key: Keitaro → profile icon → API keys → Create API key
KEITARO_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Campaign defaults (optional, can also be selected in the UI)
# ---------------------------------------------------------------------------
CAMPAIGN_PREFIX=test_kotovsky_
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/keitaro_wrapper.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/keitaro_wrapper
REPORT_TIMEZONE=Europe/Moscow
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
AUTO_CREATE_TABLES=false
SEED_OFFER_CACHE_ON_STARTUP=false

# Vite dev server (frontend build)
VITE_API_URL=http://localhost:8000/api
